NEXT_PUBLIC_APP_ENV=development        # development | staging | production
NEXT_PUBLIC_DESIGN_MODE=coming-soon    # coming-soon | full
NEXT_PUBLIC_ALLOW_INDEXING=false       # true | false
NEXT_PUBLIC_GA_ID=                     # optional; GA4 measurement ID. The script loads only in production.
NEXT_PUBLIC_DESIGN_URL=http://localhost:3000
NEXT_PUBLIC_CNC_URL=http://cnc.localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=524421234567   # Número temporal; al cambiarlo a WhatsApp Business solo se edita esta variable en Vercel y se hace redeploy
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@woodax.design
CONTACT_TO_EMAIL_CNC=cnc@woodax.design
CONTACT_FROM_EMAIL=Woodax Web <leads@notify.woodax.design>
